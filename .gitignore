# Backup artefacts. A dump contains real student records and auth identities,
# and a pg_restore listing names every table and column. Neither may enter git.
# See docs/operations/BACKUP_AND_RESTORE.md section 4.2.
*.dump
*.dump.gz
*.list.txt

# Supabase CLI local cache (machine-specific).
supabase/.temp/
supabase/.branches/

# Platform CLI state and tool caches. These are created by `netlify dev`,
# `vercel`, and Vite; none of them belong in the repository.
.netlify/
.vercel/
.vite/
*.tsbuildinfo
