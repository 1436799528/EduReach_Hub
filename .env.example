# Supabase browser configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias supported for existing environments
VITE_SUPABASE_ANON_KEY=

# Supabase server-only key. Never prefix this with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Set to 1 only when this deployment deliberately runs the legacy CBT schema
# (no cbt_attempts.protocol column). Readiness fails closed otherwise; see
# docs/features/CBT-LEGACY-SCHEMA.md.
CBT_LEGACY_SCHEMA=

# Temporary pre-launch switch. Leave unset/false while testers need immediate
# signup; set to true when Supabase email confirmation is restored.
VITE_EMAIL_VERIFICATION_ENABLED=false

# Error aggregation (optional). Leave empty to keep the tracker off: without a
# DSN the SDK is never loaded and nothing leaves the process. See
# docs/operations/MONITORING.md for the privacy configuration and quota caps.
SENTRY_DSN=
# Volume caps that keep the free tier unreachable: per hour (burst) and per day
# (monthly quota). 30/hour and 150/day can never exceed 5,000 events a month.
SENTRY_MAX_EVENTS_PER_HOUR=30
SENTRY_MAX_EVENTS_PER_DAY=150

# Slow-request threshold for the http.slow event, in milliseconds.
OBS_SLOW_REQUEST_MS=5000

# Uptime probe target (scripts/uptime-check.ts, and the scheduled workflow).
PROBE_BASE_URL=https://edureachhub.netlify.app
# 1 makes a readiness failure fatal for the probe. Leave 0 until the production
# CBT protocol migration is applied (readiness answers 503 for that reason).
UPTIME_READINESS_STRICT=0
