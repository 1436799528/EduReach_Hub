# ---------------------------------------------------------------------------
# EduReach Hub environment template — PLACEHOLDERS ONLY.
#
# Copy to `.env` (which is git-ignored) and fill in locally. Never commit a real
# value, never paste one into an issue or a document, and never put a credential
# behind a `VITE_` prefix: Vite inlines every `VITE_` value into the browser
# bundle. The classification of each variable, and the checks that enforce it,
# are in docs/ENVIRONMENT-VARIABLES.md and src/lib/envContract.ts.
#
#   PUBLIC                ships to browsers by design
#   PRIVATE               deployment configuration, not a credential
#   SECRET                a credential; server/function scope only
#   SENSITIVE_OPERATIONAL real identity/access detail, not a credential
#   DEVELOPMENT_ONLY      rehearsal switch; never set in production
# ---------------------------------------------------------------------------

# --- Supabase browser configuration (PUBLIC, build-time) -------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias supported for existing environments
VITE_SUPABASE_ANON_KEY=
# Public aliases for a host that cannot un-flag the VITE_ variable as secret
# (see docs/NETLIFY_PRODUCTION_SETUP.md section 3). Same two public values.
EDUREACH_PUBLIC_SUPABASE_URL=
EDUREACH_PUBLIC_SUPABASE_KEY=

# --- Supabase server-only key (SECRET, runtime/function scope) --------------
# Never prefix this with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Administrative bootstrap (SENSITIVE_OPERATIONAL, function scope) -------
# Leave empty in steady state. Setting it opens POST /api/admin/bootstrap for the
# account whose email matches; it is compared server-side and never sent to a
# browser. Delete the value once the first administrator exists.
EDUREACH_ADMIN_BOOTSTRAP_EMAIL=

# Set to 1 only when this deployment deliberately runs the legacy CBT schema
# (no cbt_attempts.protocol column). Readiness fails closed otherwise; see
# docs/features/CBT-LEGACY-SCHEMA.md.
CBT_LEGACY_SCHEMA=

# Error aggregation (optional, SENSITIVE_OPERATIONAL). Leave empty to keep the
# tracker off: without a DSN the SDK is never loaded and nothing leaves the
# process. See docs/operations/MONITORING.md for the privacy configuration and
# quota caps.
SENTRY_DSN=
# Volume caps that keep the free tier unreachable: per hour (burst) and per day
# (monthly quota). 30/hour and 150/day can never exceed 5,000 events a month.
SENTRY_MAX_EVENTS_PER_HOUR=30
SENTRY_MAX_EVENTS_PER_DAY=150

# Slow-request threshold for the http.slow event, in milliseconds.
OBS_SLOW_REQUEST_MS=5000

# Uptime probe target (scripts/uptime-check.ts, and the scheduled workflow).
PROBE_BASE_URL=https://edureachhub.netlify.app
# 1 makes a readiness failure fatal for the probe. Leave 0 until the production
# CBT protocol migration is applied (readiness answers 503 for that reason).
UPTIME_READINESS_STRICT=0
