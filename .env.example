# Supabase browser configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias supported for existing environments
VITE_SUPABASE_ANON_KEY=

# Supabase server-only key. Never prefix this with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Set to 1 only when this deployment deliberately runs the legacy CBT schema
# (no cbt_attempts.protocol column). Readiness fails closed otherwise; see
# docs/features/CBT-LEGACY-SCHEMA.md.
CBT_LEGACY_SCHEMA=
