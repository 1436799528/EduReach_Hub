NODE_ENV=production
PORT=3000

# Public browser configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only configuration
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Canonical site origin used by /sitemap.xml, robots.txt and canonical URLs.
# Leave unset to derive it from the request host.
EDUREACH_SITE_URL=https://edureachhub.netlify.app

# Temporary pre-launch switch. Leave unset/false while testers need immediate
# signup; set to true when Supabase email confirmation is restored.
VITE_EMAIL_VERIFICATION_ENABLED=false
